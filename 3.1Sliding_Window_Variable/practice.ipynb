   "source": [
    "s = \"pwwkew\"\n",
    "\n",
    "seen = set()\n",
    "left = 0\n",
    "right = 0\n",
    "\n",
    "while right < len(s):\n",
    "    print(f\"left:{left}\")\n",
    "    print(f\"right:{right}\")\n",
    "    print(\"-\"*20)\n",
    "    if s[right] not in seen:\n",
    "        seen.add(s[right])\n",
    "        right += 1\n",
    "    else:\n",
    "        left += 1\n",
    "        right += 1\n",
    "\n",
    "print(right - left)"
   ]
